<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout wrapper + scrollIndicator: see CurvedScrollIndicatorView's
     doc comment. scrollRoot's own android:scrollbars is "none" — the
     indicator draws over it instead of the platform's own (unreliable on
     this ROM) round scrollbar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/screen_padding_h"
    android:paddingRight="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingBottom="@dimen/screen_padding_v">

    <!-- Padding lives on the ScrollView (above), not here: its native
         scrollbar only insets itself from the ScrollView's OWN padding, not
         a child's — declaring it here instead left the scrollbar thumb
         drawn flush against the raw screen edge, under the round bezel's
         curve, inconsistently across pages. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/start_logo_size"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_mark"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:layout_marginBottom="10dp" />

        <!-- Background is set at runtime (bg_status_ok / bg_status_warn) once
             the accessibility-service state is known; this default keeps the
             page looking right for the one frame before that first bind. -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_warn"
            android:textColor="@color/status_warn_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/micStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_warn"
            android:textColor="@color/status_warn_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/contactsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_warn"
            android:textColor="@color/status_warn_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/phoneStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_warn"
            android:textColor="@color/status_warn_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/overlayStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_warn"
            android:textColor="@color/status_warn_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="6dp" />

        <!-- Shown instead of the pills above once every one of them is ok
             — each pill above is only made visible when its own check is
             actually failing (see SlotsAdapter.InfoViewHolder.bind()), so
             once nothing is missing this is the only one left visible. -->
        <TextView
            android:id="@+id/allGrantedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/bg_status_ok"
            android:textColor="@color/status_ok_text"
            android:textAppearance="@style/TextAppearance.App.StatusPill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:text="Все разрешения предоставлены" />

        <LinearLayout
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.App.Hint"
                android:text="Инструкция" />

            <ImageView
                android:id="@+id/repoQrImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@android:color/white"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.App.Hint"
                android:text="Страница проекта на Github" />

        </LinearLayout>

        <!-- Manual only, same philosophy as "Синхронизировать приложения и
             контакты" on the slot-list page: no background polling. Bound
             from MainActivity.updateStatus via SlotsAdapter.InfoViewHolder —
             see UpdateChecker/UpdateInstaller for the actual check/download/
             install logic. -->
        <LinearLayout
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/scroll_bottom_extra">

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Hint"
                android:layout_marginBottom="@dimen/space_s"
                android:text="Версия" />

            <Button
                android:id="@+id/checkUpdatesButton"
                style="@style/Widget.App.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Проверить обновления" />

            <TextView
                android:id="@+id/updateStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

    <com.nikolay.assistvoice.CurvedScrollIndicatorView
        android:id="@+id/scrollIndicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
