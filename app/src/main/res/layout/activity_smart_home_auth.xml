<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/screen_padding_h"
    android:paddingRight="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingBottom="@dimen/screen_padding_v">

    <!-- paddingTop/paddingBottom here (stacking with the ScrollView's own
         screen_padding_v) give the same round-bezel clearance as
         scroll_bottom_extra elsewhere — on the content's own wrapper
         rather than a specific last child, since retryButton isn't always
         visible so the actual last visible element varies. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="@dimen/scroll_bottom_extra"
        android:paddingBottom="@dimen/scroll_bottom_extra">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:text="Умный дом Яндекса" />

        <LinearLayout
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:text="Код" />

            <TextView
                android:id="@+id/userCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.App.Value"
                android:letterSpacing="0.08"
                android:text="…" />

            <Button
                android:id="@+id/copyCodeButton"
                style="@style/Widget.App.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:text="Скопировать код" />

            <TextView
                android:id="@+id/verificationUrlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:text="" />

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:contentDescription="QR-код для авторизации" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Hint"
            android:text="" />

        <Button
            android:id="@+id/retryButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="Обновить код"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

    <com.nikolay.assistvoice.CurvedScrollIndicatorView
        android:id="@+id/scrollIndicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
