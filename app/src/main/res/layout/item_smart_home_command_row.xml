<?xml version="1.0" encoding="utf-8"?>
<!-- One of the two fixed on/off slots for a device or group (see
     SmartHomeDeviceCommandsActivity) — always exactly two of these, never
     added or removed, only ever edited via the shared text field below (not
     by tapping a row — these are a read-only preview, not a picker).
     rowCommandBadge's colour (green/red) marks which state this slot is;
     rowCommandPhrase shows its phrase, or a muted placeholder while still
     unconfigured. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/rowCommandBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/rowCommandBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.App.Badge"
            android:text="" />

        <TextView
            android:id="@+id/rowCommandPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.RowTitle"
            android:text="" />

    </LinearLayout>

</LinearLayout>
