<resources>

    <!-- Dark by default rather than DayNight: this is a single-purpose watch
         utility that lives mostly on an AMOLED always/near-always-on round
         screen, not a document you'd want to read in a light theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:windowIsTranslucent">false</item>

        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_base</item>
        <item name="colorAccent">@color/accent</item>

        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/ripple_light</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- Per-widget default styles. Buttons default to the neutral/outline
             look (Reset peak, Reset centre); Save/Add/Delete opt into
             Primary/Danger explicitly in their layouts. -->
        <item name="buttonStyle">@style/Widget.App.Button.Outline</item>
        <item name="android:editTextStyle">@style/Widget.App.EditText</item>
        <item name="android:checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="spinnerStyle">@style/Widget.App.Spinner</item>
        <item name="android:seekBarStyle">@style/Widget.App.SeekBar</item>
    </style>

    <!-- Full-screen white "flashlight" window — see FlashlightActivity. No
         action bar, no title, no window content overlay: the requirement is
         a screen with not a single UI element on it, so there is nothing
         here beyond making the window itself take the whole screen. -->
    <style name="Theme.Flashlight" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- ===== Text ===== -->

    <!-- Bare base for the TextAppearance.App.* family below. Every child
         omits `parent` on purpose (so a future TextAppearance.App.Foo just
         works), but AAPT's implicit dot-based parent lookup only strips one
         segment and requires that exact name to exist as a real resource —
         it does not fall back to the framework android:TextAppearance family
         on its own. Without this, resource linking fails outright ("resource
         style/TextAppearance.App not found"), one error per child style. -->
    <style name="TextAppearance.App" parent="android:TextAppearance" />

    <!-- Small caps field/section label, e.g. "Тип действия", "Порог". -->
    <style name="TextAppearance.App.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Big readout, e.g. the current mic level number. -->
    <style name="TextAppearance.App.Value">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Long-form help copy at the bottom of a page. -->
    <style name="TextAppearance.App.Body">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Fine print / captions under a control. -->
    <style name="TextAppearance.App.Hint">
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Status pill text on the info page. -->
    <style name="TextAppearance.App.StatusPill">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- "Прил." / "Звонок" tag on a slot row. -->
    <style name="TextAppearance.App.Badge">
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Slot row's target app/contact name. -->
    <style name="TextAppearance.App.RowTitle">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===== Containers ===== -->

    <!-- Same reasoning as TextAppearance.App above: Widget.App.Card omits
         `parent`, so AAPT needs a real "Widget.App" resource to resolve it
         against. This one has no framework style to anchor to the way
         TextAppearance.App does (there's no useful "android:Widget" to
         inherit from), so parent="" is explicit here: it tells AAPT "no
         parent, stop looking" instead of leaving the attribute off, which
         would make AAPT repeat the exact same implicit-lookup mistake one
         level up — trying to resolve a local resource literally named
         "Widget", which doesn't exist either (that was this fix's own
         first, broken attempt: "resource style/Widget ... not found"). -->
    <style name="Widget.App" parent="" />

    <style name="Widget.App.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ===== Buttons ===== -->

    <style name="Widget.App.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.App.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Widget.App.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- ===== Inputs ===== -->

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="Widget.App.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:popupBackground">@color/bg_surface_alt</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="Widget.App.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:buttonTint">@color/accent</item>
    </style>

    <style name="Widget.App.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/bg_seekbar_track</item>
        <item name="android:thumb">@drawable/bg_seekbar_thumb</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
    </style>

</resources>
