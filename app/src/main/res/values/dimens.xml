<?xml version="1.0" encoding="utf-8"?>
<!--
     Round-screen dp sizing, tiered by the device's reported screen width
     (which for a round watch face is effectively its diameter in dp — dp
     already absorbs pixel-density differences on its own, so width-in-dp is
     the one thing that still varies meaningfully device to device and needs
     its own values here).

     Only the w320dp tier (see values-w320dp/dimens.xml) is actually
     verified on real hardware — Huawei Watch 4 Pro, this app's one tested
     device. This file (the default/no-qualifier tier, used below the
     smallest -w threshold present — see values-w280dp and values-w380dp for
     the tiers above it) and the other tiers are a straight linear scale of
     those verified values against a representative diameter for each
     bracket, not independently confirmed against real screens that size.
     Treat them as a reasoned starting point to adjust once tested on an
     actual device in that range, especially scroll_bottom_extra — round
     bezel curvature isn't guaranteed to scale linearly with diameter the
     way a straight ratio assumes.

     Bracket    Threshold   Representative  Scale (vs. 320dp)
     default    (none)      ~240dp          0.75
     w280dp     280dp+      ~280dp          0.875
     w320dp     320dp+      320dp           1.0 (verified)
     w380dp     380dp+      ~380dp          1.1875
-->
<resources>

    <!-- Screen padding. Horizontal stays modest; vertical is generous on
         purpose — on a round watch face the ScrollView's own top/bottom
         padding is what keeps the first and last rows out of the narrow
         part of the circle where the bezel starts cutting corners off. -->
    <dimen name="screen_padding_h">16dp</dimen>
    <dimen name="screen_padding_v">22dp</dimen>

    <!-- Extra bottom margin on the last card of a scrolling page —
         screen_padding_v alone wasn't enough to fully clear the last card
         past the round bezel's curve when scrolled all the way down. -->
    <dimen name="scroll_bottom_extra">21dp</dimen>

    <!-- Logo mark shown above the "ASSIST VOICE" label on the start screen
         (item_info.xml). Width only — height follows via adjustViewBounds
         since logo_mark.png isn't a perfect square (204x188 content). -->
    <dimen name="start_logo_size">54dp</dimen>

    <dimen name="space_xs">3dp</dimen>
    <dimen name="space_s">6dp</dimen>
    <dimen name="space_m">9dp</dimen>
    <dimen name="space_l">14dp</dimen>
    <dimen name="space_xl">20dp</dimen>

    <dimen name="card_radius">14dp</dimen>
    <dimen name="button_radius">16dp</dimen>
    <dimen name="input_radius">9dp</dimen>

</resources>
